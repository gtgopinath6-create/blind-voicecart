# Copy to server/.env and fill in. Never commit server/.env.
# On a hosting platform, set these as environment variables / secrets instead of using a file.

# --- Required in production ---
NODE_ENV=development
# Must equal the projectId of the frontend build (ID tokens are checked against it).
FIREBASE_PROJECT_ID=e-commerce-website-69

# Firebase Admin credentials (required for checkout, wallet and admin user management). Use ONE:
#  a) Application Default Credentials, e.g. the service account attached to Cloud Run (no key file):
# FIREBASE_ADMIN_USE_ADC=true
#  b) Path to a service-account JSON key (Firebase console > Project settings > Service accounts).
#     Keep the file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional ---
# Groq key for AI voice commands (https://console.groq.com/keys). Without it, the offline parser is used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (gpt-oss models only). Lower uses fewer tokens per command.
GROQ_REASONING_EFFORT=low

# Port to listen on. Hosting platforms usually set PORT themselves.
PORT=5055

# Only needed if the frontend is served from a different origin than the API (comma-separated).
# ALLOWED_ORIGINS=https://shop.example.com

# Number of proxies in front of the server, used to find the client IP for rate limits.
# 1 (default) for Cloud Run, Render or a single reverse proxy; 2 for Firebase Hosting -> Cloud Run
# (verify, see DEPLOYMENT.md); false when nothing is in front of the server.
# TRUST_PROXY=1

# Test money without a payment provider. Honoured ONLY when NODE_ENV is not production AND the
# server uses the Firestore emulator (FIRESTORE_EMULATOR_HOST). Ignored against any real project.
ALLOW_DEV_WALLET_CREDIT=false
