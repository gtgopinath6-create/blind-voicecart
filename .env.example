# Frontend build-time settings. Everything here is PUBLIC: it is bundled into the browser.
# Never put API keys or other secrets here. The Groq key belongs in the server environment.

# Optional: URL of the VoiceCart API when it is not served from the same origin as the app.
# Leave unset when /api is routed to the server on the same domain (firebase.json does this for
# Firebase Hosting). In development, /api is proxied to http://localhost:5055 ("proxy" in package.json).
# REACT_APP_API_BASE_URL=https://api.example.com

# Optional: point a build at another Firebase project (for example staging). Set ALL six or none;
# with none set, the built-in e-commerce-website-69 settings in src/components/firebase.js are used.
# Values: Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_STORAGE_BUCKET=
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# REACT_APP_FIREBASE_APP_ID=

# Optional: products per page on category pages and per "Show more" (default 24). A smaller page
# reads fewer Firestore documents per view.
# REACT_APP_CATALOG_PAGE_SIZE=24

# Optional, development only: use the local Auth and Firestore emulators (ports in firebase.json)
# instead of a real project. Ignored by production builds. See "Try sign-in, checkout and admin
# locally" in README.md for the full command.
# REACT_APP_USE_FIREBASE_EMULATORS=true

# Optional: forces which speech-to-text engine Zoro's command mode uses for everyone on this build,
# overriding each shopper's own "Listening and speech settings" choice. Values: automatic (default;
# the browser's own recognition where supported, otherwise the server's Whisper endpoint), webspeech
# (always the browser's own recognition), whisper (always upload to the server). The "Hey Zoro" wake
# word always uses the browser's own recognition regardless of this setting.
# REACT_APP_VOICE_STT_MODE=automatic
